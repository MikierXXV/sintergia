{
  "name": "sintergia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Los conceptos de Jacobo Grinberg y lo que se sabe de ellos",
  "scripts": {
    "dev": "vite",
    "build": "npm run validar && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validar": "node scripts/validar-contenido.mjs && node scripts/comprobar-fichas.mjs && node scripts/validar-maquinas.mjs && node scripts/check-contraste.mjs && node scripts/check-idiomas.mjs",
    "validar:contenido": "node scripts/validar-contenido.mjs",
    "validar:contraste": "node scripts/check-contraste.mjs",
    "validar:idiomas": "node scripts/check-idiomas.mjs",
    "auditar": "node scripts/auditar.mjs",
    "capturar": "node scripts/capturar-sitio.mjs",
    "modelo": "node scripts/optimizar-modelo.mjs",
    "metricas": "node scripts/metricas-respaldo.mjs",
    "alineacion": "node scripts/check-alineacion.mjs",
    "validar:fichas": "node scripts/comprobar-fichas.mjs",
    "importar-reels": "node scripts/importar-reels.mjs",
    "validar:maquinas": "node scripts/validar-maquinas.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^3.10.1",
    "@gltf-transform/extensions": "^3.10.1",
    "@gltf-transform/functions": "^3.10.1",
    "@types/node": "^22.10.0",
    "@types/three": "^0.171.0",
    "meshoptimizer": "^0.20.0",
    "playwright": "1.62.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "lenis": "^1.3.28",
    "three": "^0.171.0"
  }
}
